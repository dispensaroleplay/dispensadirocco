{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dispensadirocco",
  "main": "./worker.js",
  "compatibility_date": "2026-08-19",
  "keep_vars": true,

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": true,

    "exclude": [
      "worker.js",
      "_worker.js",
      "wrangler.jsonc",
      "README.md",
      "SETUP-WORKERS.md",
      ".gitignore",
      ".assetsignore",
      "dev-vars.example",
      ".dev.vars",
      ".dev.vars.*",
      ".env",
      ".env.*",
      "node_modules/**",
      ".wrangler/**",
      "functions/**",
      "public/**",
      "*.zip",
      "assets/*.png"
    ]
  },

  "vars": {
    "DISCORD_GUILD_ID": "1529971523924791478",
    "DISCORD_CHANNEL_ID": "1537538848660390018",
    "DISCORD_MESSAGE_ID": "1537545350313938954"
  },

  "observability": {
    "enabled": true
  }
}
